+/* ------------------------------------------------------------------
+   main.css - Layout and components. Values come from tokens.css only.
+------------------------------------------------------------------- */
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: var(--font-body);
+  font-size: var(--text-md);
+  line-height: 1.55;
+  color: var(--ink);
+  background: var(--paper);
+  -webkit-font-smoothing: antialiased;
+}
+
+h1,
+h2,
+h3 {
+  margin: 0;
+  font-weight: var(--weight-semibold);
+  line-height: 1.25;
+}
+
+p {
+  margin: 0 0 var(--s-3);
+}
+
+a {
+  color: var(--accent);
+  text-decoration: none;
+}
+
+a:hover {
+  color: var(--accent-strong);
+  text-decoration: underline;
+}
+
+code,
+pre {
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* Eyebrow: uppercase mono label used to mark sections of the system */
+.eyebrow {
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* ---------------------------------------------------------------
+   Top navigation
+--------------------------------------------------------------- */
+
+.nav {
+  position: sticky;
+  top: 0;
+  z-index: 10;
+  display: flex;
+  align-items: center;
+  gap: var(--s-5);
+  height: var(--nav-height);
+  padding: 0 var(--s-5);
+  background: var(--surface);
+  border-bottom: 1px solid var(--line);
+}
+
+.nav-brand {
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+  font-weight: var(--weight-semibold);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+  color: var(--ink);
+}
+
+.nav-brand:hover {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-links {
+  display: flex;
+  gap: var(--s-4);
+  margin-right: auto;
+}
+
+.nav-links a {
+  font-size: var(--text-sm);
+  color: var(--muted);
+  padding: var(--s-1) 0;
+  border-bottom: 2px solid transparent;
+}
+
+.nav-links a:hover {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-links a[aria-current="page"] {
+  color: var(--ink);
+  border-bottom-color: var(--accent);
+}
+
+.nav-user {
+  font-size: var(--text-sm);
+  color: var(--faint);
+}
+
+/* ---------------------------------------------------------------
+   Page scaffold
+--------------------------------------------------------------- */
+
+.page {
+  max-width: var(--content-max);
+  margin: 0 auto;
+  padding: var(--s-6) var(--s-5) var(--s-8);
+}
+
+.page-head {
+  margin-bottom: var(--s-6);
+}
+
+.page-head h1 {
+  font-size: var(--text-xl);
+  margin-top: var(--s-1);
+}
+
+.page-head .lede {
+  color: var(--muted);
+  max-width: 44rem;
+  margin-top: var(--s-2);
+}
+
+/* ---------------------------------------------------------------
+   Cards
+--------------------------------------------------------------- */
+
+.card {
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+  padding: var(--s-5);
+}
+
+.card-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
+  gap: var(--s-4);
+}
+
+.card h2 {
+  font-size: var(--text-lg);
+  margin-bottom: var(--s-2);
+}
+
+.card .card-meta {
+  color: var(--faint);
+  font-size: var(--text-sm);
+}
+
+a.card {
+  display: block;
+  color: var(--ink);
+}
+
+a.card:hover {
+  text-decoration: none;
+  border-color: var(--line-strong);
+  box-shadow: var(--shadow-raised);
+}
+
+.stat {
+  font-size: var(--text-2xl);
+  font-weight: var(--weight-semibold);
+  font-variant-numeric: tabular-nums;
+}
+
+/* ---------------------------------------------------------------
+   Forms and buttons
+--------------------------------------------------------------- */
+
+.field {
+  margin-bottom: var(--s-4);
+}
+
+.field label {
+  display: block;
+  font-size: var(--text-sm);
+  font-weight: var(--weight-medium);
+  margin-bottom: var(--s-1);
+}
+
+.field input,
+.field select {
+  width: 100%;
+  padding: var(--s-2) var(--s-3);
+  font: inherit;
+  font-size: var(--text-sm);
+  color: var(--ink);
+  background: var(--surface);
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-sm);
+}
+
+.field input:focus,
+.field select:focus {
+  outline: 2px solid var(--accent);
+  outline-offset: 0;
+  border-color: var(--accent);
+}
+
+.button {
+  display: inline-block;
+  padding: var(--s-2) var(--s-4);
+  font: inherit;
+  font-size: var(--text-sm);
+  font-weight: var(--weight-medium);
+  color: #ffffff;
+  background: var(--accent);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-sm);
+  cursor: pointer;
+}
+
+.button:hover {
+  background: var(--accent-strong);
+  border-color: var(--accent-strong);
+}
+
+.button.secondary {
+  color: var(--ink);
+  background: var(--surface);
+  border-color: var(--line-strong);
+}
+
+.button.secondary:hover {
+  background: var(--paper);
+}
+
+.button.quiet {
+  color: var(--muted);
+  background: transparent;
+  border-color: transparent;
+  padding: var(--s-1) var(--s-2);
+}
+
+.button.quiet:hover {
+  color: var(--ink);
+  background: var(--paper);
+}
+
+/* ---------------------------------------------------------------
+   Notices
+--------------------------------------------------------------- */
+
+.notice {
+  padding: var(--s-3) var(--s-4);
+  font-size: var(--text-sm);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-sm);
+  background: var(--surface);
+  color: var(--muted);
+}
+
+.notice.error {
+  background: var(--danger-soft);
+  border-color: var(--danger);
+  color: var(--danger);
+}
+
+.notice.hidden {
+  display: none;
+}
+
+/* ---------------------------------------------------------------
+   Tables
+--------------------------------------------------------------- */
+
+.table-wrap {
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  overflow-x: auto;
+}
+
+table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--text-sm);
+}
+
+th {
+  text-align: left;
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+  color: var(--muted);
+  padding: var(--s-3) var(--s-4);
+  border-bottom: 1px solid var(--line);
+  white-space: nowrap;
+}
+
+td {
+  padding: var(--s-3) var(--s-4);
+  border-bottom: 1px solid var(--line);
+  vertical-align: top;
+}
+
+tr:last-child td {
+  border-bottom: none;
+}
+
+td.mono {
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+/* ---------------------------------------------------------------
+   Badges
+--------------------------------------------------------------- */
+
+.badge {
+  display: inline-block;
+  padding: 0.1rem var(--s-2);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-semibold);
+  letter-spacing: 0.03em;
+  border-radius: var(--radius-sm);
+  color: var(--muted);
+  background: var(--paper);
+  border: 1px solid var(--line);
+}
+
+.badge.get    { color: var(--m-get);    background: var(--m-get-bg);    border-color: transparent; }
+.badge.post   { color: var(--m-post);   background: var(--m-post-bg);   border-color: transparent; }
+.badge.put    { color: var(--m-put);    background: var(--m-put-bg);    border-color: transparent; }
+.badge.patch  { color: var(--m-patch);  background: var(--m-patch-bg);  border-color: transparent; }
+.badge.delete { color: var(--m-delete); background: var(--m-delete-bg); border-color: transparent; }
+
+.badge.live       { color: var(--ok);     background: var(--ok-soft);     border-color: transparent; }
+.badge.draft      { color: var(--warn);   background: var(--warn-soft);   border-color: transparent; }
+.badge.deprecated { color: var(--danger); background: var(--danger-soft); border-color: transparent; }
+.badge.admin      { color: var(--accent); background: var(--accent-soft); border-color: transparent; }
+
+/* ---------------------------------------------------------------
+   Login
+--------------------------------------------------------------- */
+
+.login-shell {
+  min-height: 100vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: var(--s-5);
+}
+
+.login-card {
+  width: 100%;
+  max-width: 24rem;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-raised);
+  padding: var(--s-6);
+}
+
+.login-card .wordmark {
+  font-family: var(--font-mono);
+  font-size: var(--text-md);
+  font-weight: var(--weight-semibold);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+}
+
+.login-card .wordmark span {
+  color: var(--accent);
+}
+
+.login-card .lede {
+  color: var(--muted);
+  font-size: var(--text-sm);
+  margin: var(--s-2) 0 var(--s-5);
+}
+
+/* ---------------------------------------------------------------
+   Reference viewer (the swagger)
+--------------------------------------------------------------- */
+
+.ref-layout {
+  display: grid;
+  grid-template-columns: var(--sidebar-width) 1fr;
+  gap: var(--s-5);
+  align-items: start;
+}
+
+.ref-sidebar {
+  position: sticky;
+  top: calc(var(--nav-height) + var(--s-4));
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: var(--s-4);
+  max-height: calc(100vh - var(--nav-height) - var(--s-6));
+  overflow-y: auto;
+}
+
+.ref-sidebar .group {
+  margin-bottom: var(--s-4);
+}
+
+.ref-sidebar .group:last-child {
+  margin-bottom: 0;
+}
+
+.ref-sidebar ul {
+  list-style: none;
+  margin: var(--s-2) 0 0;
+  padding: 0;
+}
+
+.ref-sidebar li a {
+  display: flex;
+  align-items: baseline;
+  gap: var(--s-2);
+  padding: var(--s-1) var(--s-2);
+  border-radius: var(--radius-sm);
+  color: var(--ink);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+  overflow-wrap: anywhere;
+}
+
+.ref-sidebar li a:hover {
+  background: var(--paper);
+  text-decoration: none;
+}
+
+.endpoint {
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  margin-bottom: var(--s-4);
+  scroll-margin-top: calc(var(--nav-height) + var(--s-4));
+}
+
+.endpoint > summary {
+  display: flex;
+  align-items: baseline;
+  gap: var(--s-3);
+  padding: var(--s-3) var(--s-4);
+  cursor: pointer;
+  list-style: none;
+}
+
+.endpoint > summary::-webkit-details-marker {
+  display: none;
+}
+
+.endpoint > summary:hover {
+  background: var(--paper);
+}
+
+.endpoint .path {
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+  font-weight: var(--weight-medium);
+  overflow-wrap: anywhere;
+}
+
+.endpoint .summary-text {
+  color: var(--muted);
+  font-size: var(--text-sm);
+  margin-left: auto;
+  text-align: right;
+}
+
+.endpoint-body {
+  border-top: 1px solid var(--line);
+  padding: var(--s-4);
+}
+
+.endpoint-body h3 {
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+  color: var(--muted);
+  margin: var(--s-4) 0 var(--s-2);
+}
+
+.endpoint-body h3:first-child {
+  margin-top: 0;
+}
+
+.codeblock {
+  position: relative;
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-sm);
+}
+
+.codeblock pre {
+  margin: 0;
+  padding: var(--s-3) var(--s-4);
+  overflow-x: auto;
+}
+
+.codeblock .copy {
+  position: absolute;
+  top: var(--s-2);
+  right: var(--s-2);
+}
+
+.spec-picker {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  margin-bottom: var(--s-5);
+}
+
+.spec-picker select {
+  padding: var(--s-2) var(--s-3);
+  font: inherit;
+  font-size: var(--text-sm);
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-sm);
+  background: var(--surface);
+}
+
+/* ---------------------------------------------------------------
+   Responsive
+--------------------------------------------------------------- */
+
+@media (max-width: 56rem) {
+  .ref-layout {
+    grid-template-columns: 1fr;
+  }
+
+  .ref-sidebar {
+    position: static;
+    max-height: none;
+  }
+
+  .endpoint .summary-text {
+    display: none;
+  }
+
+  .nav {
+    gap: var(--s-3);
+    overflow-x: auto;
+  }
+}
